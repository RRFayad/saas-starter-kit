{
  "name": "saas-starter-kit",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "predev": "docker compose up -d",
    "dev": "concurrently -n web,api,stripe,clerk -c blue,green,magenta,cyan \"npm run dev -w @app/frontend\" \"npm run dev -w @app/backend\" \"node scripts/dev-stripe.mjs\" \"node scripts/dev-clerk.mjs\"",
    "stripe:listen": "stripe listen --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed --forward-to localhost:3000/api/webhooks/stripe",
    "clerk:webhook-url": "node scripts/dev-clerk.mjs --print-url",
    "db:generate": "npm run db:generate -w @app/shared",
    "db:migrate": "npm run db:migrate -w @app/shared",
    "db:studio": "npm run db:studio -w @app/shared",
    "build": "npm run build -w @app/frontend",
    "lint": "eslint",
    "check": "npm run lint && prettier --check . && npm run typecheck --workspaces --if-present && npm test",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "clerk": "^4.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  },
  "overrides": {
    "@fastify/static": "10.1.3"
  }
}
